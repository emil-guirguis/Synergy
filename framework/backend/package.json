{
  "name": "@meterit/framework-backend",
  "version": "1.0.0",
  "description": "Shared backend framework for MeterIt applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
