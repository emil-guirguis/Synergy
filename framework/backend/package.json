    "joi": "^17.13.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3"
  }
}
