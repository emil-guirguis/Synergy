{
  "name": "meteritpro-client-mcp",
  "version": "1.0.0",
  "description": "Client MCP Server for centralized monitoring and alerts",
  "type": "module",
  "main": "dist/MeterItPro/mcp/src/index.js",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "start": "node --env-file=.env dist/MeterItPro/mcp/src/index.js",
    "dev": "npm run clean && tsc && node --env-file=.env dist/MeterItPro/mcp/src/index.js",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@meterit/framework-backend": "file:../../framework/backend",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "nodemailer": "^6.10.1",
    "node-cron": "^3.0.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.5",
    "@types/nodemailer": "^7.0.2",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alerts",
    "notifications"
  ],
  "author": "",
  "license": "MIT"
}
