{
  "name": "tbwc-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy:site": "node scripts/deploy-to-site.mjs"
  },
  "dependencies": {
    "@meterit/framework-frontend": "file:../../framework/frontend",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "apexcharts": "^5.10.4",
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "react": "^19.1.1",
    "react-apexcharts": "^2.1.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
