{
  "name": "tbwc-api",
  "version": "1.0.0",
  "description": "Backend API for the TBWC portal (Cloudflare Worker)",
  "scripts": {
    "start": "wrangler dev",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "images:plan": "node scripts/fetch-item-images.cjs --dry-run",
    "images:families": "node scripts/fetch-item-images.cjs --families-only",
    "images:fetch": "node scripts/fetch-item-images.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@meterit/framework-backend": "file:../../framework/backend",
    "@types/pg": "^8.15.5",
    "hono": "^4.11.9",
    "mammoth": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "postal-mime": "^4.0.5",
    "unpdf": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "sharp": "^0.35.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  },
  "license": "MIT"
}
